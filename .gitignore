!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# testing
frontend/coverage/

# next.js
frontend/.next/
frontend/out/

# production
frontend/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env examples
!.env.example

# vercel
frontend/.vercel/

# typescript
*.tsbuildinfo
frontend/next-env.d.ts

# backend/rust
backend/target/

#For nix flake
!.envrc
.direnv/

# Database files
*.db
*.db-wal
*.db-shm
*.db-journal

